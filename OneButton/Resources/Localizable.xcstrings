      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically Check for Updates"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 업데이트 확인"
          }
        }
      }
    },
    "Automatically Download and Install": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically Download and Install"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 다운로드 및 설치"
          }
        }
      }
    },
    "Cannot access this folder. Please reconnect it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot access this folder. Please reconnect it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더에 접근할 수 없습니다. 폴더를 다시 연결해 주세요."
          }
        }
      }
    },
    "Check for Updates…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for Updates…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 업데이트 확인…"
          }
        }
      }
    },
    "Check the folder connection and access permission.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the folder connection and access permission."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 연결과 접근 권한을 확인해 주세요."
          }
        }
      }
    },
    "Choose a folder to connect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder to connect."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결할 폴더를 선택해 주세요."
          }
        }
      }
    },
    "Choose a folder to connect. Its files will appear here so you can open them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder to connect. Its files will appear here so you can open them."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결할 폴더를 선택해 주세요. 파일 목록을 표시하고 선택한 파일을 엽니다."
          }
        }
      }
    },
    "Click once to select, double-click to open, or drag to another app to attach.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click once to select, double-click to open, or drag to another app to attach."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 클릭하여 선택, 더블클릭하여 열기 또는 다른 앱으로 드래그하여 첨부"
          }
        }
      }
    },
    "Click once to select, or double-click to open in Finder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click once to select, or double-click to open in Finder."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 클릭하여 선택, 더블클릭하여 Finder에서 열기"
          }
        }
      }
    },
