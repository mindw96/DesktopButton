{
  "sourceLanguage": "en",
  "strings": {
    "Unable to Rename the App": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to Rename the App"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 파일 이름을 변경하지 못했습니다"
          }
        }
      }
    },
    "Folder In Bar.app already exists in the same folder. You can keep using the current app. Check both apps before removing a duplicate.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder In Bar.app already exists in the same folder. You can keep using the current app. Check both apps before removing a duplicate."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 폴더에 Folder In Bar.app이 이미 있습니다. 기존 앱은 그대로 사용할 수 있습니다. 두 앱을 확인하신 뒤 중복 파일을 정리해 주세요."
          }
        }
      }
    },
    "You do not have permission to write to the app’s folder. You can keep using the current app, or rename it to Folder In Bar.app in Finder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You do not have permission to write to the app’s folder. You can keep using the current app, or rename it to Folder In Bar.app in Finder."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 있는 폴더에 쓰기 권한이 없습니다. 기존 앱은 그대로 사용할 수 있으며 Finder에서 앱 파일 이름을 Folder In Bar.app으로 바꾸실 수 있습니다."
          }
        }
      }
    },
    "The app is still running, so its name was not changed. Quit the app and open it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is still running, so its name was not changed. Quit the app and open it again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중인 앱이 종료되지 않아 파일 이름을 바꾸지 않았습니다. 앱을 종료한 뒤 다시 실행해 주세요."
          }
        }
      }
    },
    "Unable to Reopen the App": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to Reopen the App"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 다시 열지 못했습니다"
          }
        }
      }
    },
    "Open the app again in Finder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the app again in Finder."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서 앱을 다시 열어 주세요."
          }
        }
      }
    },
    "The app could not be safely verified, so the operation was stopped. Check the app in Finder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app could not be safely verified, so the operation was stopped. Check the app in Finder."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 파일을 안전하게 확인할 수 없어 작업을 중단했습니다. Finder에서 앱을 확인해 주세요."
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인"
          }
        }
      }
    }
  },
  "version": "1.0"
}
